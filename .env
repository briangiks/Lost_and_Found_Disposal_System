APP_NAME="Strathmore Lost & Found"
APP_ENV=local
APP_KEY=base64:9k3shs5iMhtI9In7kxZex0a0xaS4Tcio/ytTR9Fkqvw=
APP_DEBUG=true
APP_TIMEZONE=Africa/Nairobi
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Default database is SQLite so the project runs immediately with zero setup.
# Switch DB_CONNECTION to mysql and fill in the credentials below if you'd
# rather use MySQL / MariaDB (e.g. via XAMPP/Laragon for the demo).
# DB_CONNECTION=sqlite
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=strathmore_lost_found
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="lostandfound@strathmore.edu"
MAIL_FROM_NAME="Strathmore Lost & Found Office"

# Lost & Found business rules
LNF_DISPOSAL_AGE_DAYS=90
LNF_EARLY_WARNING_DAYS=83
LNF_PICKUP_WINDOW_DAYS=7
LNF_OFFICE_LOCATION="Central Building Phase 1 Basement — Lost & Found Dept"
LNF_COMMS_EMAIL="communications@strathmore.edu"
LNF_OUTREACH_EMAIL="outreach.club@strathmore.edu"
LNF_OFFICE_EMAIL="lostandfound@strathmore.edu"
