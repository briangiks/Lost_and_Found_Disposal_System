APP_NAME="Strathmore Lost & Found"
APP_ENV=local
APP_KEY=base64:ss6TKU02RcWzfuhuQwItADHfJRthX6dtX1Em04wNCwM=
APP_DEBUG=true
APP_TIMEZONE=Africa/Nairobi
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Default database is SQLite so the project runs immediately with zero setup.
# Switch DB_CONNECTION to mysql and fill in the credentials below if you'd
# rather use MySQL / MariaDB (e.g. via XAMPP/Laragon for the demo).
# DB_CONNECTION=sqlite
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=strathmore_lost_found
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

# "sync" runs jobs (like sending email) immediately with zero setup — fine for a
# demo/defense. For a real deployment switch to "database" and run a queue worker
# (php artisan queue:work) so email sending doesn't block the request/command that
# triggered it. The `jobs` table already exists for this (see database/migrations).
QUEUE_CONNECTION=sync

CACHE_STORE=file

# MAIL_MAILER=log just writes emails to storage/logs/laravel.log — nothing is
# actually sent, which keeps the demo self-contained. Every email sent by this
# app is also logged as a real row in the `sent_emails` table regardless of this
# setting, so the Email Preview page works either way.
#
# To send real email, pick ONE of the blocks below and set MAIL_MAILER to match.
# MAIL_MAILER=log

# --- Option A: SMTP (Gmail, Outlook, your university's mail server, etc.) ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=brian.gichuru@strathmore.edu
MAIL_PASSWORD=rzbhxranmdoopoav
MAIL_ENCRYPTION=tls

# --- Option B: Mailgun ---
# MAIL_MAILER=mailgun
# MAILGUN_DOMAIN=mg.strathmore.edu
# MAILGUN_SECRET=your-mailgun-api-key
# MAILGUN_ENDPOINT=api.mailgun.net

MAIL_FROM_ADDRESS="brian.gichuru@strathmore.edu"
MAIL_FROM_NAME="Strathmore Lost & Found Office"

# Lost & Found business rules
LNF_DISPOSAL_AGE_DAYS=90
LNF_EARLY_WARNING_DAYS=83
LNF_PICKUP_WINDOW_DAYS=7
LNF_OFFICE_LOCATION="Central Building Phase 1 Basement — Lost & Found Dept"
LNF_COMMS_EMAIL="brian.gichuru@strathmore.edu"
LNF_OUTREACH_EMAIL="brian.gichuru@strathmore.edu"
LNF_OFFICE_EMAIL="brian.gichuru@strathmore.edu"
LNF_STUDENTS_LIST_EMAIL="brian.gichuru@strathmore.edu"
LNF_REPLY_TO_EMAIL=null

# Turn off to fall back to the fully-manual workflow (officer clicks through
# every stage themselves) instead of the Day-90 / Day-97 automation.
LNF_AUTOMATION_ENABLED=true
